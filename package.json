{
  "type": "module",
  "name": "de-santos-bolos-orders-service",
  "version": "1.0.0",
  "private": true,
  "description": "Orders microservice for De Santos Bolos: product catalog and customer orders.",
  "main": "index.js",
  "scripts": {
    "dev": "tsx --watch --env-file=.env ./index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:products": "tsx --env-file=.env ./scripts/seed-products.ts",
    "typeorm": "tsx --env-file=.env ./node_modules/typeorm/cli.js",
    "migration:run": "npm run typeorm -- migration:run -d ./src/database/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d ./src/database/data-source.ts",
    "migration:show": "npm run typeorm -- migration:show -d ./src/database/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate -d ./src/database/data-source.ts"
  },
  "license": "ISC",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  }
}
